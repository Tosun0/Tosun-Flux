FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Source/TosunFluxWeb/requirements.txt Source/TosunFluxWeb/requirements.txt
RUN pip install --no-cache-dir -r Source/TosunFluxWeb/requirements.txt

COPY Source/TosunFluxBackend Source/TosunFluxBackend
COPY Source/TosunFluxWeb Source/TosunFluxWeb
COPY Content/TosunFlux Content/TosunFlux

ENV PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "python -m uvicorn Source.TosunFluxWeb.TosunFluxWeb:app --host 0.0.0.0 --port ${PORT}"]
