<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TosunFluxMac.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="avares://TosunFluxMac/Assets/Pretendard.ttf#Pretendard" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#8C9BFF" />
      <Setter Property="Foreground" Value="#10121A" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18,12" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#252A38" />
      <Setter Property="Foreground" Value="#E9ECF7" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="ComboBox, TextBox">
      <Setter Property="Background" Value="#1B1F2A" />
      <Setter Property="Foreground" Value="#F4F6FF" />
      <Setter Property="BorderBrush" Value="#30374A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="#F4F6FF" />
    </Style>
  </Application.Styles>
</Application>
